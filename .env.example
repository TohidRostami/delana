# --- دیتابیس (محلی: فایل SQLite) ---
DATABASE_URL="file:./prisma/dev.db"

# --- دیتابیس پروداکشن (Turso) — در صورت تنظیم، جایگزین فایل محلی می‌شود ---
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- احراز هویت (Better Auth) ---
# با دستور `openssl rand -base64 32` یک مقدار تصادفی بسازید
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# دامنه‌های اضافه مجاز برای احراز هویت (جداشده با کاما)، مثلاً نسخه www
BETTER_AUTH_TRUSTED_ORIGINS=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- پیامک (sms.ir) ---
SMSIR_API_KEY=""
SMSIR_VERIFY_TEMPLATE_ID=""
SMSIR_VERIFY_PARAM_NAME="code"

# --- درگاه پرداخت (زرین‌پال) ---
# در پروداکشن حتماً مقدار بدهید. خالی = شبیه‌ساز داخلی (فقط در حالت توسعه)
PAYMENT_GATEWAY_MERCHANT_ID=""
# true = درگاه آزمایشی (sandbox) زرین‌پال
PAYMENT_GATEWAY_SANDBOX="false"
# فقط برای تست روی سرور غیرتوسعه: فعال‌سازی شبیه‌ساز پرداخت (در پروداکشن واقعی false بماند)
ALLOW_PAYMENT_SIMULATOR="false"

# --- Object Storage آروان‌کلاد (آپلود عکس محصولات) ---
ARVAN_ENDPOINT=""
ARVAN_BUCKET=""
ARVAN_ACCESS_KEY=""
ARVAN_SECRET_KEY=""
ARVAN_PUBLIC_URL_BASE=""

# --- واتس‌اپ فروشگاه (اختیاری، بدون + و صفر اول؛ مثل 989121234567) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=""
